# Hostinger SMTP credentials (for sending contact form emails)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=connect@kmonlinesolutions.com
SMTP_PASS=your-email-password-here

# Where contact form submissions are sent
CONTACT_EMAIL=connect@kmonlinesolutions.com

# MySQL credentials (blog + database-driven content)
# Option 1 (simplest): a single connection string.
# MYSQL_URL=mysql://user:password@host:port/database
# Option 2: individual variables (ignored when MYSQL_URL is set).
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your-mysql-user-here
MYSQL_PASSWORD=your-mysql-password-here
MYSQL_DATABASE=kmonlinesolutions
